# backend/.env.example
# Untuk development dengan SQLite (tanpa perlu PostgreSQL):
DATABASE_URL=sqlite+aiosqlite:///./butir.db
# Untuk production dengan PostgreSQL (lalu jalankan `alembic upgrade head`):
# DATABASE_URL=postgresql+asyncpg://butir:butir@localhost:5432/butir
# BUAT_SKEMA_OTOMATIS=false
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_MINUTES=1440
# Produksi di belakang HTTPS (lihat DEPLOY.md): alihkan http ke https + HSTS, dan wajibkan JWT_SECRET kuat.
# PAKSA_HTTPS=true
# Pembagian penyedia sesuai SRS: Primer -> Agen Kritikus dan Penjawab Buta,
# Sekunder (keluarga model berbeda) -> Agen Penyusun dan Arbiter.
PROVIDER_PRIMER=groq
PROVIDER_SEKUNDER=sambanova
# true: bila API key salah satu penyedia kosong, peran terkait gagal (butir 'tertunda').
# false: peran itu dialihkan ke penyedia lain dan dicatat sebagai fallback di log.
STRICT_DUA_PENYEDIA=false
GROQ_API_KEY=
GROQ_MODEL_PENYUSUN=openai/gpt-oss-120b
GROQ_MODEL_KRITIKUS=qwen/qwen3.8-27b
GROQ_MODEL_PENJAWAB_BUTA=openai/gpt-oss-20b
GROQ_MODEL_ARBITER=qwen/qwen3.8-27b
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL_PENYUSUN=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_MODEL_ARBITER=DeepSeek-V3.1
# Bankai (gateway kompatibel OpenAI). Pakai dengan PROVIDER_SEKUNDER=bankai atau PROVIDER_PRIMER=bankai.
BANKAI_API_KEY=
# Key khusus kelompok Primer (opsional). Kosong = memakai BANKAI_API_KEY. Dua key memisahkan batas laju.
BANKAI_API_KEY_PRIMER=
BANKAI_BASE_URL=https://bankai.web.id/api
# Primer (Kritikus, Penjawab Buta) dan Sekunder (Penyusun, Arbiter) sebaiknya beda keluarga model.
BANKAI_MODEL_PENYUSUN=deepseek-v4-flash
BANKAI_MODEL_KRITIKUS=glm-5.3-flashx-mod
BANKAI_MODEL_PENJAWAB_BUTA=glm-5.3-flashx-mod
BANKAI_MODEL_ARBITER=deepseek-v4-flash
# Advance (gateway kompatibel OpenAI lain). Dipakai dengan PROVIDER_SEKUNDER=advance atau PROVIDER_PRIMER=advance.
ADVANCE_API_KEY=
ADVANCE_BASE_URL=https://api.advance.my.id/v1
ADVANCE_MODEL_PENYUSUN=deepseek-v4-pro
ADVANCE_MODEL_KRITIKUS=glm-5.3-flashx-mod
ADVANCE_MODEL_PENJAWAB_BUTA=glm-5.3-flashx-mod
ADVANCE_MODEL_ARBITER=deepseek-v4-pro
# Model cadangan (dipisah koma, dicoba berurutan di penyedia yang SAMA) bila model utama lambat atau gagal.
# Pakai keluarga model yang tidak sama dengan model utama kelompok lawan. Kosongkan untuk mematikan.
# Tersedia untuk ADVANCE dan BANKAI; nilai di bawah adalah bawaan bila baris ini tidak diisi.
# ADVANCE_MODEL_PENYUSUN_CADANGAN=deepseek-v4-pro-0813,kimi-k2.8
# ADVANCE_MODEL_ARBITER_CADANGAN=deepseek-v4-pro-0813,kimi-k2.8
# ADVANCE_MODEL_KRITIKUS_CADANGAN=glm-5.3-flash,mimo-v2.6-pro
# ADVANCE_MODEL_PENJAWAB_BUTA_CADANGAN=glm-5.3-flash,mimo-v2.6-pro
# BANKAI_MODEL_PENYUSUN_CADANGAN=deepseek-v4-pro-0813,kimi-k2.8
# BANKAI_MODEL_ARBITER_CADANGAN=deepseek-v4-pro-0813,kimi-k2.8
# BANKAI_MODEL_KRITIKUS_CADANGAN=glm-5.3-flash,mimo-v2.6-pro
# BANKAI_MODEL_PENJAWAB_BUTA_CADANGAN=glm-5.3-flash,mimo-v2.6-pro
# Batas waktu satu panggilan (detik), jumlah kegagalan berturut-turut sebelum pindah model, dan lama model
# yang ditinggalkan dilewati (detik).
# LLM_TIMEOUT_DETIK=90
# LLM_GAGAL_SEBELUM_PINDAH=2
# LLM_MODEL_SAKIT_DETIK=300
FRONTEND_URL=http://localhost:3000
# Akun admin (dipisah koma): melihat penugasan penyedia LLM dan mengelola paket. Email ini otomatis berperan admin.
ADMIN_EMAILS=

# Email reset kata sandi. Kosongkan SMTP_HOST untuk development: tautan dicetak ke log server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Jalur HTTPS (port 443) lewat Mailjet; dipakai lebih dulu bila diisi. Berguna saat jaringan/hosting memblokir port SMTP.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM=
# Resend (HTTPS, dipakai paling dulu bila diisi). Tanpa domain terverifikasi, Resend hanya mengirim ke email pemilik akun dari onboarding@resend.dev.
RESEND_API_KEY=
RESEND_FROM=
RESET_TOKEN_EXPIRE_MINUTES=30

# Masuk dengan Google: OAuth Client ID (Web application). Kosongkan untuk menyembunyikan tombol Google.
GOOGLE_CLIENT_ID=
# Kode masuk lewat email (6 digit). Tanpa SMTP_HOST, kode dicetak ke log server.
KODE_MASUK_MENIT=10
MAX_RONDE_DEBAT=3
